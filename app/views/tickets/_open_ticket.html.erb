<% decorated_ticket = ticket.decorate %>

<tr id="<%= dom_id(ticket) %>">
  <td class="w-full table-cell">
    <%= link_to ticket_path(ticket), class: "truncate hover:text-gray-600 hover:underline" do %>
      <span class="text-gray-900 block whitespace-normal line-clamp-3"><%= decorated_ticket.description.upcase_first %></span>
    <% end %>
  </td>

  <td class="table-cell"><span class="text-gray-900 text-left whitespace-nowrap"><%= decorated_ticket.user.decorate.display_name %></span></td>

  <td class="table-cell"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-900 whitespace-nowrap"><%= decorated_ticket.ticket_label.name.titleize %></span></td>

  <td class="table-cell"><span class="text-gray-900 text-left whitespace-nowrap"><%= display_created_at(decorated_ticket) %></span></td>

  <td class="table-cell"><span class="text-gray-900 text-left whitespace-nowrap"><%= display_date(decorated_ticket.updated_at) %></span></td>

  <td class="table-cell"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= decorated_ticket.display_status_color %>-100 text-<%= decorated_ticket.display_status_color %>-800 whitespace-nowrap"><%= decorated_ticket.display_status %></span></td>

  <td class="table-cell"><span class="text-gray-900 text-left whitespace-nowrap"><%= decorated_ticket.ticket_label.user.decorate.display_name %></span></td>
</tr>
