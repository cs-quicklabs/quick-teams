<%= tailwind_form_with(model: ticket, id: dom_id(ticket), url: tickets_path) do |form| %>
  <main class="max-w-lg px-4 pt-6 pb-12 mx-auto space-y-4 lg:pb-16">
    <%= render "shared/form_header", title: local_assigns[:title], subtitle: local_assigns[:subtitle] %>
    <% labels = TicketLabel.all.load %>

    <% if labels.size > 0 %>
      <%= render "shared/form_messages", resource: ticket, message: local_assigns[:message] %>
      <%= form.hidden_field :user_id, value: current_user.id %>
      <%= form.hidden_field :account_id, value: current_user.account.id %>
      <div><%= form.text_area :description, title: "Description something", placeholder: "Describe the issue..." %></div>
      <div data-controller="select" data-select-param-value="discipline_id" data-select-url-value="tickets/labels">
        <div><%= form.label :ticket_label_id, "Select Label", class: "block mt-4 text-sm font-medium text-gray-700" %><%= form.collection_select :ticket_label_id, labels, :id, :name, { prompt: "Select Label" }, { class: "form-text-field mt-1", data: { select_target: "select" } } %></div>
      </div>
      <div class="flex justify-end"><%= form.submit "Add Ticket", class: "btn-primary" %></div>
    <% else %>
      <% if current_user.admin? %>
        <div>
          <p class="mt-2 text-xs text-gray-500" id="label-description">Please add new ticket labels from <%= link_to "Account > Ticket Labels", account_ticket_labels_path, class: "text-indigo-700 hover:underline" %>. These are required to create a new Ticket.</p>
        </div>
      <% else %>
        <div>
          <p class="mt-2 text-xs text-gray-500" id="label-missing">
            It appears the admin has not set up ticket labels. Please contact the admin. The account needs to have ticket labels before a ticket can be raised.
          </p>
        </div>
      <% end %>
    <% end %>
  </main>
<% end %>
