<%= tailwind_form_with(model: todo, id: dom_id(todo), url: employee_todos_path(@employee)) do |form| %>
  <main class="max-w-lg px-4 pt-6 pb-12 mx-auto space-y-4 lg:pb-16">
    <%= render "shared/form_messages", resource: todo, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Add New Todo", subtitle: "Todo are short term goals" %>
    <%= form.text_field :title, "Title", autocomplete: "off" %>
    <%= form.text_area :body, "Description(optional)", class: "form-text-field h-24" %>

    <div><label for="date" class="block text-sm font-medium text-gray-700">Due Date</label><%= form.date_field :deadline, class: "form-text-field mt-1", value: Date.today.to_formatted_s(:db) %></div>

    <div class="flex justify-end"><%= form.submit "Add Todo", class: "btn-primary" %></div>


      <div id="alert-1" class="flex sm:items-center p-4 mb-4 text-sm text-primry-900 rounded-sm bg-primary-200" role="alert">
  <svg class="w-4 h-4 shrink-0 mt-0.5 md:mt-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
  <span class="sr-only">Info</span>
  <div class="ms-2 text-sm">
    Open <%= @employee.first_name %>'s <a href="<%= employee_planner_daily_path(@employee) %>" class="font-medium underline hover:no-underline">daily or weekly planner</a>.
  </div>
</div>

  </main>
<% end %>
