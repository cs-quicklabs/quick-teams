<!-- This example requires Tailwind CSS v2.0+ -->

<main class="max-w-4xl px-4 pt-10 pb-12 mx-auto space-y-4 lg:pb-16">
  <div class="px-4 py-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex-1 min-w-0">
      <h3 class="text-2xl font-bold leading-tight text-gray-900 items-center space-x-3 flex">
        <%# Feedback type indicator %>
        <% color_class =
        case @feedback.feedback_type
        when "positive" then "bg-green-600"
        when "negative" then "bg-red-600"
        when "neutral"  then "bg-gray-600"
        else "bg-gray-200"
        end %>

        <span class="inline-block w-4 h-4 rounded-full align-middle mr-2 <%= color_class %>"></span>

        <%= highlight_hashtag(@feedback.title.upcase_first) %>

        <% if @feedback.is_kpi? %>
          <span class="inline-flex items-center ml-2 px-2.5 py-0.5 rounded-sm text-xs font-medium bg-blue-100 text-blue-800">
            KPI
          </span>
        <% end %>
      </h3>

      <div class="flex mt-4 space-x-3">
        <div class="flex-shrink-0"><%= display_medium_avatar(@feedback.critiquable) %></div>

        <div>
          <div class="text-sm">
            <a
              href="<%= employee_feedbacks_path(@feedback.critiquable) %>"
              class="font-medium text-gray-900 hover:underline"
            >
              <%= @feedback.critiquable.decorate.display_name %>
            </a>
          </div>

          <div class="mt-1 space-x-2 text-sm">
            <span class="font-medium text-gray-500">
              <%= @feedback.user.decorate.display_name + " added on " + display_created_at(@feedback) %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="flex mt-4 sm:mt-0 sm:ml-4">
      <%= link_to "Back", "javascript:history.back()", class: "btn-secondary" %>
    </div>

    <% if policy([@employee, @feedback]).edit? %>
      <%= link_to "Edit", edit_employee_feedback_path(@feedback.critiquable, @feedback), class: "btn-primary ml-2" %>
    <% end %>
  </div>

  <% cache @feedback do %>
    <div class="mt-1 text-sm text-gray-700 sm:px-6 lg:px-8">
      <p><%= @feedback.body %></p>
    </div>
  <% end %>

  <% if current_user.admin? %>
    <div id="feedback-status-<%= @feedback.id %>">
      <%= render partial: "employee/feedbacks/status", locals: { feedback: @feedback } %>
    </div>
  <% end %>
</main>
