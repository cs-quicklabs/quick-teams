<%= tailwind_form_with(model: user, id: dom_id(user), url: "password") do |form| %>
  <div class="space-y-4">
    <%= render "shared/form_messages", resource: user, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Change Password", subtitle: "Please fill in details to change your password." %>

    <div><%= form.label :original_password, "Old Password", class: "block text-sm font-medium text-gray-700" %><%= form.password_field :original_password, autocomplete: "current-password", class: "form-text-field mt-1", placeholder: "Old Password" %></div>

    <div><%= form.label :new_password, "New Password", class: "block text-sm font-medium text-gray-700" %><%= form.password_field :new_password, autocomplete: "new-password", class: "form-text-field mt-1", placeholder: "New Password" %></div>

    <div><%= form.label :new_password_confirmation, "Confirm New Password", class: "block text-sm font-medium text-gray-700" %><%= form.password_field :new_password_confirmation, autocomplete: "new-password", class: "form-text-field mt-1", placeholder: "Confirm New Password" %></div>

    <div class="flex justify-end"><%= form.submit "Save", class: "btn-primary" %></div>
  </div>
<% end %>
