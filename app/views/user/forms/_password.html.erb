<%= tailwind_form_with(model: user, id: dom_id(user), url: "password") do |form| %>
  <div class="mb-6 space-y-4">
    <div class="space-y-4">
      <%= render "shared/form_messages", resource: user, message: local_assigns[:message] %>
      <%= render "shared/form_header", title: "Change Password", subtitle: "Please fill in details to change your password." %>

      <%= form.password_field :original_password, autocomplete: "current-password", placeholder: "Old Password" %>
    </div>

    <div><%= form.password_field :new_password, autocomplete: "new-password", placeholder: "New Password" %></div>

    <div>
      <%= form.password_field :new_password_confirmation, autocomplete: "new-password", placeholder: "Confirm New Password" %>
    </div>

    <div class="flex justify-end"><%= form.submit "Save", class: "btn-primary" %></div>
  </div>
<% end %>
