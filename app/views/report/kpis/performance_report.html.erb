<div class="d-inline-block">
  <h2 class="mt-1 w-full font-semibold">
    <%= @kpis.last.participant.decorate.display_name %>
  </h2>
</div>

<p class="mt-1 w-full text-sm text-gray-500">
  This KRA report is from
  <%= params[:from_date].to_s %>
  to
  <%= params[:to_date].to_s %>
  . Names of the reviewers are hidden for anonymity.
</p>

<div class="pb-12 d-flex justify-content-start">
  <div>
    <table class="table mt-2">
      <thead>
        <tr class="d-flex">
          <th class="col-1 px-1" style="text-align: left">#</th>
          <th class="col-2 px-1" style="text-align: left">Date</th>
          <th class="col-1 px-1" style="text-align: left">Score</th>
          <th class="col-11 px-1" style="text-align: left">Comment</th>
        </tr>
      </thead>

      <tbody class="bg-white divide-y divide-gray-200">
        <% @kpis.each_with_index do |attempt, index| %>
          <% decorated_attempt = attempt.decorate %>

          <tr>
            <td><%= index + 1 %></td>
            <td><%= display_date(decorated_attempt.created_at) %></td>
            <td><%= decorated_attempt.display_score %></td>
            <td colspan="1"><%= decorated_attempt.comment %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
