<!-- Modal for viewing job card details -->
<div id="jobCardDetailsModal" class="hidden fixed inset-0 bg-black/75 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg p-6 w-1/3">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-bold">Job Card Details</h3>

      <button
        type="button"
        data-action="click->weekly-planner#closeDetailsModal"
        class="text-gray-500 hover:text-gray-700 cursor-pointer"
      >
        ✕
      </button>
    </div>

    <div class="space-y-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
        <div class="form-text-field" data-weekly-planner-target="detailsTitle"></div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
        <div class="form-text-field h-24" data-weekly-planner-target="detailsDescription"></div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
          <div class="form-text-field" data-weekly-planner-target="detailsDate"></div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Session</label>
          <div class="form-text-field capitalize" data-weekly-planner-target="detailsSession"></div>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Duration</label>
        <div class="form-text-field" data-weekly-planner-target="detailsDuration"></div>
      </div>
    </div>

    <div class="flex justify-end mt-6">
      <button type="button" data-action="click->weekly-planner#closeDetailsModal" class="btn-primary">Close</button>
    </div>
  </div>
</div>
