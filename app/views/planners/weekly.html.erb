<div data-controller="weekly-planner" data-weekly-planner-start-date-value="<%= @start_date.iso8601 %>">
  <div class="flex justify-between items-center p-4">
    <h2 class="text-2xl font-bold">
      <%= @user.first_name %>'s Weekly Planner - <%= @start_date.strftime('%B %d') %> - <%= (@start_date + 4.days).strftime('%B %d, %Y') %>
    </h2>
    <div class="space-x-2">
        <%= link_to "Daily Planner", employee_planner_daily_path, class: "px-3 py-1 bg-blue-300 rounded" %>
              <%= link_to "Weekly Planner", employee_planner_weekly_path, class: "px-3 py-1 bg-green-300 rounded" %>
    </div>
    
    
    <div class="space-x-2">
      <%= link_to "← Previous", employee_planner_weekly_path(week: @start_date - 1.week), class: "px-3 py-1 bg-gray-300 rounded" %>
      <%= link_to "This Week", employee_planner_weekly_path, class: "px-3 py-1 bg-green-300 rounded" %>
      <%= link_to "Next →", employee_planner_weekly_path(week: @start_date + 1.week), class: "px-3 py-1 bg-gray-300 rounded" %>
    </div>
  </div>

  <div class="grid grid-cols-5 gap-4 h-screen">
    <% @dates.each do |date| %>
      <div class="bg-white rounded-lg shadow-md h-full flex flex-col">
        <h3 class="text-center font-semibold p-3 bg-gray-100 rounded-t-lg flex-shrink-0">
          <%= date.strftime('%a %m/%d') %>
        </h3>
        
       <div class="p-2 flex-1 flex flex-col space-y-2">
          <% %w[morning afternoon evening].each do |session| %>
            <div class="session-slot  border border-gray-200 rounded flex-1 space-y-1 p-1 overflow-y-auto"
                 data-date="<%= date.iso8601 %>"
                 data-session="<%= session %>"
                 >
              
              <% cards = @grouped_cards[[date, session]] %>
              <% if cards && cards.any? %>
                <% cards.each_with_index do |card, index| %>
                  <div class="job-card inset-x-2 bg-green-400 text-white rounded p-1 overflow-hidden"
                       style="top: <%= 1 + (index) %>rem; z-index: 10; height: <%= (card.slot_length * 1.5) + ((card.slot_length - 1) * 0.25) %>rem;"
                       data-card-id="<%= card.id %>"
                       data-action="click->weekly-planner#showCardDetails">

                    <div class="text-xs font-medium truncate"><%= card.title %></div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Modal for creating/editing job cards -->
    <!-- Modal for viewing job card details -->
  <div id="jobCardDetailsModal" class="hidden fixed inset-0 bg-black/75  flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 w-96">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold">Job Card Details</h3>
        <button type="button" 
                data-action="click->weekly-planner#closeDetailsModal" 
                class="text-gray-500 hover:text-gray-700">
          ✕
        </button>
      </div>
      
      <div class="space-y-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
          <div class="text-sm bg-gray-50 p-2 rounded" data-weekly-planner-target="detailsTitle"></div>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <div class="text-sm bg-gray-50 p-2 rounded min-h-16" data-weekly-planner-target="detailsDescription"></div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
            <div class="text-sm bg-gray-50 p-2 rounded" data-weekly-planner-target="detailsDate"></div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Session</label>
            <div class="text-sm bg-gray-50 p-2 rounded capitalize" data-weekly-planner-target="detailsSession"></div>
          </div>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Duration</label>
          <div class="text-sm bg-gray-50 p-2 rounded" data-weekly-planner-target="detailsDuration"></div>
        </div>
      </div>
      
      <div class="flex justify-end mt-6">
        <button type="button" data-action="click->weekly-planner#closeDetailsModal" 
                class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">Close</button>
      </div>
    </div>
  </div>

</div>