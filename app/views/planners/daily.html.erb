<div data-controller="daily-planner" data-daily-planner-date-value="<%= @date.iso8601 %>">
  <div class="flex justify-between items-center p-4">
    <h2 class="text-2xl font-bold"> <%= @user.first_name %>'s Daily Planner - <%= @date.strftime('%A, %B %d, %Y') %></h2>

    <div class="space-x-2">
        <%= link_to "Daily Planner", employee_planner_daily_path, class: "px-3 py-1 bg-blue-300 rounded" %>
              <%= link_to "Weekly Planner", employee_planner_weekly_path, class: "px-3 py-1 bg-green-300 rounded" %>
    </div>

    <div class="space-x-2">
      <%= link_to "← Previous", employee_planner_daily_path(date: @date - 1.day), class: "px-3 py-1 bg-gray-300 rounded" %>
      <%= link_to "Today", employee_planner_daily_path, class: "px-3 py-1 bg-blue-300 rounded" %>
      <%= link_to "Next →", employee_planner_daily_path(date: @date + 1.day), class: "px-3 py-1 bg-gray-300 rounded" %>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-6 px-4">
    <% %w[morning afternoon evening].each_with_index do |session, session_index| %>
      <div class="bg-white rounded-lg shadow-md p-4">
        <h3 class="font-semibold mb-4 text-center capitalize bg-gray-200 py-1 rounded">
          <%= session %> (3 hours)
        </h3>
        
        <div class="relative">
          <% 9.times do |slot_index| %>
            <% slot_number = slot_index + 1 %>
            <% existing_card = @grouped_cards[[session, slot_number]]&.first %>
            
            <div class="slot relative border border-gray-200 mb-1 rounded"
                 style="height: 2.5rem;"
                 data-session="<%= session %>"
                 data-slot="<%= slot_number %>"
                 data-action="click->daily-planner#openModal">
              
              <div class="absolute inset-0 flex items-center justify-center text-xs text-gray-400 cursor-pointer">
                Slot <%= slot_number %> (20 min)
              </div>
              
              <% if existing_card %>
              <div class="job-card absolute inset-0 <%= existing_card.color_class %> text-white rounded p-1 cursor-pointer overflow-hidden"
                     style="height: <%= (existing_card.slot_length * 2.5) + ((existing_card.slot_length - 1) * 0.25) %>rem; z-index: 1;"
                     data-card-id="<%= existing_card.id %>"
>
                  <div class="text-xs font-medium truncate"><%= existing_card.title %></div>
                  <div class="text-xs opacity-75">
                    <%
                      total_minutes = existing_card.slot_length * 20
                      if total_minutes >= 60
                        hours = total_minutes / 60
                        minutes = total_minutes % 60
                        if minutes > 0
                    %>
                      <%= hours %>h <%= minutes %>m
                    <% else %>
                      <%= hours %>h
                    <% end %>
                    <% else %>
                      <%= total_minutes %> min
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Modal for creating/editing job cards -->
  <div id="jobCardModal" class="hidden fixed inset-0 bg-black/75 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 w-1/3">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg leading-6 font-bold text-gray-900" data-daily-planner-target="modalTitle">Add Job Card</h3>
        <button type="button" 
                data-daily-planner-target="deleteButton"
                data-action="click->daily-planner#deleteCard" 
                class="hidden px-3 py-1 bg-red-500 text-white text-sm rounded hover:bg-red-600 cursor-pointer">
          Delete
        </button>
      </div>
      
      <form data-action="submit->daily-planner#submitForm" data-daily-planner-target="cardForm">
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
          <input type="text" name="title" class="w-full form-text-field" required data-daily-planner-target="titleInput">
        </div>
        
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea name="description" class="w-full form-text-field h-20" data-daily-planner-target="descriptionInput"></textarea>
        </div>
        
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Duration</label>
          <select name="slot_length" class="w-full form-text-field" required data-daily-planner-target="slotLengthInput">
            <% (1..9).each do |slots| %>
 <% 
                total_minutes = slots * 20
                if total_minutes >= 60
                  hours = total_minutes / 60
                  minutes = total_minutes % 60
                  time_display = minutes > 0 ? "#{hours}h #{minutes}m" : "#{hours}h"
                else
                  time_display = "#{total_minutes} min"
                end
              %>
              <option value="<%= slots %>"><%= slots %> slot<%= 's' if slots > 1 %> (<%= time_display %>)</option>
                       <% end %>
          </select>
        </div>
        
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">Color (Optional)</label>
          <div class="flex flex-col space-x-2">

            <div class="flex items-center">
              <input type="radio" id="color_green" name="color" value="green" class="mr-1" data-daily-planner-target="colorInput">
              <label for="color_green" class="text-sm flex items-center">
                <span class="w-4 h-4 bg-green-500 rounded mr-1"></span>
                Green - Deep Work, Important or priority tasks
              </label>
            </div>
            <div class="flex items-center">
              <input type="radio" id="color_yellow" name="color" value="yellow" class="mr-1" data-daily-planner-target="colorInput">
              <label for="color_yellow" class="text-sm flex items-center">
                <span class="w-4 h-4 bg-yellow-500 rounded mr-1"></span>
                Yellow - Maintenance, routine, or admin tasks
              </label>
            </div>
            <div class="flex items-center">
              <input type="radio" id="color_blue" name="color" value="blue" class="mr-1" data-daily-planner-target="colorInput">
              <label for="color_blue" class="text-sm flex items-center">
                <span class="w-4 h-4 bg-blue-500 rounded mr-1"></span>
                Blue - Meetings, Discussions or Team management
              </label>
            </div>
                        <div class="flex items-center">
              <input type="radio" id="color_gray" name="color" value="gray" class="mr-1" checked data-daily-planner-target="colorInput">
              <label for="color_gray" class="text-sm flex items-center">
                <span class="w-4 h-4 bg-gray-500 rounded mr-1"></span>
                Gray - Breaks, Learning or fun activities
              </label>
            </div>

            <div class="flex items-center">
              <input type="radio" id="color_red" name="color" value="red" class="mr-1" data-daily-planner-target="colorInput">
              <label for="color_red" class="text-sm flex items-center">
                <span class="w-4 h-4 bg-red-500 rounded mr-1"></span>
                Red - Time Wasters, Distractions or unproductive tasks
              </label>
          </div>
          </div>
        </div>
        
        <input type="hidden" name="date" value="<%= @date.iso8601 %>">
        <input type="hidden" name="session" data-daily-planner-target="modalSession">
        <input type="hidden" name="slot_start" data-daily-planner-target="modalSlot">
        <input type="hidden" name="card_id" data-daily-planner-target="cardId">
          <input type="hidden" name="user_id" value="<%= @user.id%>">
        
        <div class="flex justify-end space-x-2">
          <button type="button" data-action="click->daily-planner#closeModal" 
                  class="btn-secondary">Cancel</button>
          <button type="submit" class="btn-primary" data-daily-planner-target="saveButton">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>