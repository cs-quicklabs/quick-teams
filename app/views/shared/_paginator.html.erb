<% link = pagy_anchor(pagy) %>

<%# refactored: common classes %>

<% base_page = "px-3 py-2 text-sm font-medium leading-tight text-gray-700 border-r border-gray-200 page" %>

<% prev_classes = "#{base_page} prev hover:text-gray-900 hover:bg-gray-100" %>

<% prev_disabled_classes = "#{base_page} cursor-not-allowed prev hover:bg-gray-100 disabled" %>

<% page_item_classes = "#{base_page} hover:text-gray-900 hover:bg-gray-100" %>

<% current_item_classes = "px-3 py-2 text-sm font-medium leading-tight text-gray-700 text-blue-600 bg-gray-100 border-r border-gray-200 page current hover:text-gray-900 hover:bg-gray-100" %>

<% gap_classes = "#{base_page} gap hover:bg-gray-100" %>

<% next_classes = "px-3 py-2 text-sm font-medium leading-tight text-gray-700 text-gray-900 border-r border-transparent border-gray-200 page hover:text-gray-900 next hover:bg-gray-100" %>

<% next_disabled_classes = "#{base_page} cursor-not-allowed page next disabled hover:bg-gray-100" %>

<nav aria-label="Pagination" class="inline-flex border border-gray-200 rounded-sm shadow-md pagy_nav pagination" role="navigation">
  <% if pagy.prev %>
    <span class="<%= prev_classes %>"><%== link.(pagy.prev, "&lt;", aria_label: "Previous") %></span>
  <% else %>
    <span class="<%= prev_disabled_classes %>">
      <a
        href="#"
        role="link"
        aria-disabled="true"
        aria-label="Previous"
      >
        &lt;
      </a>
    </span>
  <% end %>

  <% pagy.series.each do |item| %>
    <% if item.is_a?(Integer) %>
      <span class="<%= page_item_classes %>"><%== link.(item) %></span>
    <% elsif item.is_a?(String) %>
      <span class="<%= current_item_classes %>"><%= item %></span>
    <% elsif item == :gap %>
      <span class="<%= gap_classes %>"><%== "&hellip;" %></span>
    <% end %>
  <% end %>

  <% if pagy.next %>
    <span class="<%= next_classes %>"><%= link_to raw("&gt;"), pagy_url_for(pagy, pagy.next), rel: "next", aria: { label: "Next" } %></span>
  <% else %>
    <span class="<%= next_disabled_classes %>">
      <a
        href="#"
        role="link"
        aria-disabled="true"
        aria-label="Next"
      >
        &gt;
      </a>
    </span>
  <% end %>
</nav>
