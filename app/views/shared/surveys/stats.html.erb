<% if @kpi.culture? %>
  <%= render partial: "shared/surveys/culture_stats", locals: { employee: @employee, kpi: @kpi, stats: @stats, show_own_attempts: @show_own_attempts } %>
<% else %>
  <%= render partial: "shared/surveys/kpi_stats", locals: { employee: @employee, kpi: @kpi, stats: @stats, show_own_attempts: @show_own_attempts } %>
<% end %>
