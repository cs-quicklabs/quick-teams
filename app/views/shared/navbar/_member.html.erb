<div class="flex items-center justify-center flex-1 sm:items-stretch sm:justify-start w-full">
  <div class="flex items-center flex-shrink-0">
    <h1 class="text-white font-extrabold font-mono">Quick Teams</h1>
  </div>

  <div class="hidden sm:block sm:ml-6">
    <div class="flex space-x-4">
      <%# local helper to keep nav class logic DRY %>
      <% nav_class = ->(path) { current_page?(path) ? "nav-selected" : "nav-unselected" } %>

      <%= link_to current_user.first_name, employee_schedules_path(current_user), class: nav_class.call(employee_schedules_path(current_user)) %>

      <% if policy(:projects).index? %>
        <%= link_to "Projects", projects_path, class: nav_class.call(projects_path) %>
      <% end %>

      <% if policy(:ticket).index? %>
        <%= link_to "Tickets", tickets_path, class: nav_class.call(tickets_path) %>
      <% end %>

      <% if policy(:spaces).index? %>
        <%= link_to "Spaces", spaces_path, class: nav_class.call(spaces_path) %>
      <% end %>

      <%= link_to "Job Card", employee_planner_daily_path(current_user), class: nav_class.call(employee_planner_daily_path(current_user)) %>

    </div>
  </div>
</div>
