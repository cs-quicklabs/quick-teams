<div
  class="
    absolute inset-y-0 right-0 items-center flex-shrink-0 pr-2 py-2
    sm:static sm:inset-auto sm:pr-0
  "
>
  <!-- Profile dropdown -->
  <div
    class="relative z-10"
    data-controller="dropdown"
    data-action="click@window->dropdown#hide keydown.escape@window->dropdown#hide"
  >
    <div>
      <button
        data-action="click->dropdown#toggle"
        data-dropdown-target="button"
        id="user-menu"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="user-menu-dropdown"
        class="
          flex text-white text-sm bg-gray-800 rounded-full
          focus:outline-none focus:ring-2 focus:ring-offset-2
          focus:ring-offset-gray-800 focus:ring-white
        "
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z"
          />
        </svg>
      </button>
    </div>

    <div
      id="user-menu-dropdown"
      data-dropdown-target="menu"
      class="
        hidden absolute right-0 mt-2 w-60 origin-top-right rounded-md
        shadow-lg transition ease-out duration-100
      "
      role="menu"
      aria-orientation="vertical"
      aria-labelledby="user-menu"
    >
      <div class="py-1 bg-white rounded-md border border-gray-200">
        <% if policy(:ticket).index? %>
          <%= link_to "Tickets", tickets_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" %>
        <% end %>

        <%= link_to "Surveys & KRAs", surveys_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" %>
        <%= link_to "Report Templates", templates_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" %>
      </div>
    </div>
  </div>
</div>
