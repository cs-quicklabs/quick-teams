<div data-reflex-permanent>
  <!-- This example requires Tailwind CSS v2.0+ -->
  <nav class="bg-gray-800" id="menubar">
    <div class="px-2 mx-auto sm:px-6 lg:px-8">
      <div class="relative flex items-center justify-between h-12">
        <%= render "shared/navbar/default" %>

        <div class="absolute inset-y-0 right-0 items-center flex-shrink-0 pr-2 sm:static sm:inset-auto sm:ml-6 sm:pr-0">
          <!-- Profile dropdown -->
          <div class="relative z-10 ml-3" data-controller="dropdown" data-action="click@window->dropdown#hide keydown.escape@window->dropdown#hide">
            <div>
              <button
                data-action="click->dropdown#toggle"
                data-dropdown-target="button"
                id="user-menu"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="user-menu-dropdown"
                class="flex text-sm bg-gray-800 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-white"
              >
                <%= display_small_avatar(current_user) %>
              </button>
            </div>

            <div
              id="user-menu-dropdown"
              data-dropdown-target="menu"
              class="hidden absolute right-0 mt-2 w-60 origin-top-right rounded-md shadow-lg transition ease-out duration-100"
              role="menu"
              aria-orientation="vertical"
              aria-labelledby="user-menu"
            >
              <div class="py-1 bg-white rounded-md border border-gray-200">
                <div class="px-4 py-3">
                  <p class="text-sm">Signed in as</p>
                  <p class="text-xs text-gray-400 truncate font-small max-w-auto"><%= current_user.email %></p>
                </div>

                <div class="border-t border-gray-100">
                  <div>
                    <% if current_user.admin? %>
                      <%= link_to "Account", (current_user.is_owner? ? detail_path : account_disciplines_path), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" %>
                      <%= link_to "Archive", archived_projects_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" %>
                    <% end %>

                    <%= link_to "Settings", profile_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" %>
                    <%= link_to "Sign Out", destroy_user_session_path, data: { "turbo-method": :delete }, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</div>
