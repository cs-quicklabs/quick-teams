<main class="relative z-0 flex-1 overflow-y-auto focus:outline-none">
  <!-- Page title & actions -->
  <div class="px-4 py-4 border-b border-gray-200 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-baseline -mt-2 -ml-2">
      <h1 class="text-3xl font-bold leading-tight text-gray-900">
        Select Survey
      </h1>

      <p class="mt-1 ml-1 text-sm text-gray-500 truncate"><%= "(" + @surveys.load.size.to_s + " Surveys)" %></p>
    </div>

    <div
      class="flex w-full max-w-3xl px-2 lg:ml-6"
      data-behavior="autocomplete"
      data-controller="nav-search"
      data-nav-search-url-value="/search/surveys"
    >
      <div class="w-full">
        <div class="relative">
          <input
            id="search"
            name="search"
            class="pl-10 pr-3 form-text-field"
            placeholder="Search Survey"
            type="search"
            autocomplete="off"
            data-nav-search-target="input"
          >
        </div>

        <div class="relative">
          <div
            class="absolute left-0 z-10 block w-full mt-2 origin-top-right bg-white rounded-md shadow-lg focus:outline-none"
            role="menu"
            aria-orientation="vertical"
            aria-labelledby="options-menu"
          >
            <ul data-nav-search-target="results"></ul>
          </div>
        </div>
      </div>
    </div>

    <div class="flex mt-4 sm:mt-0 sm:ml-4"><%= link_to "New Survey", new_survey_path, class: "btn-primary" %></div>
  </div>

  <% if @surveys.size > 0 %>
    <div class="sm:block" data-controller="infinite-scroll">
      <div class="inline-block min-w-full align-middle">
        <table class="table">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="w-full table-head">
                Surveys
              </th>

              <th scope="col" class="table-head">
                Added by
              </th>

              <th scope="col" class="table-head">
                Survey type
              </th>

              <th scope="col" class="table-head">
                Survey for
              </th>

              <th scope="col" class="table-head">
                Created on
              </th>
            </tr>
          </thead>

          <tbody class="table-body" id="surveys" data-infinite-scroll-target="entries"><%= render partial: "survey", collection: @surveys, as: :survey, cached: true %></tbody>
        </table>

        <div class="flex justify-end invisible mt-2 mb-6 mr-2" data-infinite-scroll-target="pagination"><%= render partial: "shared/paginator", locals: { pagy: @pagy } %></div>
      </div>
    </div>
  <% else %>
    <%= render partial: "shared/no_result_found" %>
  <% end %>
</main>
